# --- Database (Supabase Postgres) ---
# Use the SESSION-mode connection string (port 5432): session advisory locks do not work through the
# transaction pooler (port 6543). Supabase dashboard -> Project Settings -> Database -> URI (Session pooler).
# The session pooler allows 15 clients per project in total. Each instance of this app uses up to 5
# (pool of 4 + the poller's lock session), so the deployed API + one local instance + a test run just fit.
# A third instance sees "max clients reached in session mode": stop one, do not raise the pool size.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- App ---
# Comma-separated origins allowed to call the API (the deployed frontend + local dev).
CORS_ORIGINS=http://localhost:5173
# Market data provider for this process:
#   replay    - deterministic simulator anchored to real closes (default)
#   composite - live Yahoo while NSE is open; circuit breaker + labelled fallback to replay otherwise
#   yahoo     - live only, no fallback
MARKET_PROVIDER=replay
# Optional second feed for cross-source reconciliation (composite mode only; free key at twelvedata.com).
# Its quotes are never served; divergence beyond the threshold marks the symbol "disputed".
# TWELVEDATA_API_KEY=
DISPUTE_THRESHOLD_PCT=2.0
DISPUTE_WINDOW_SECONDS=120
# Deterministic seed so the replay demo is reproducible.
REPLAY_SEED=42

# --- Poller (shared per-symbol ingestion) ---
POLL_INTERVAL_SECONDS=5
PRUNE_INTERVAL_SECONDS=120
QUOTE_RETENTION_HOURS=24
# Run the poller in-process inside the API (single-container deploy). Set false to run it standalone.
RUN_POLLER=true
