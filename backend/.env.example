# --- Database (Supabase Postgres) ---
# Use the SESSION-mode connection string (direct / port 5432) for local dev and the poller,
# because LISTEN/NOTIFY + session advisory locks (added in later milestones) do NOT work through
# the transaction pooler (port 6543). For M1 either works, but standardize on session mode now.
# Supabase dashboard -> Project Settings -> Database -> Connection string -> URI (Session pooler).
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- App ---
# Comma-separated origins allowed to call the API (the deployed frontend + local dev).
CORS_ORIGINS=http://localhost:5173
# Market data provider for this process:
#   replay    - deterministic simulator, anchored to real closes (the reproducible demo backbone; default)
#   composite - LIVE Yahoo when NSE is open, circuit breaker + honest fallback to replay otherwise
#   yahoo     - live only, no fallback (experiments)
MARKET_PROVIDER=replay
# Optional SECOND real feed for cross-source reconciliation (composite mode only). Free key at twelvedata.com.
# Its quotes are a cross-check that is never served; divergence beyond the threshold => "disputed".
# TWELVEDATA_API_KEY=
DISPUTE_THRESHOLD_PCT=2.0
DISPUTE_WINDOW_SECONDS=120
# Deterministic seed so the Replay demo tells the same story every run.
REPLAY_SEED=42

# --- Poller (shared per-symbol ingestion) ---
POLL_INTERVAL_SECONDS=5
PRUNE_INTERVAL_SECONDS=120
QUOTE_RETENTION_HOURS=24
# Run the poller in-process inside the API (single-container deploy). Set false to run it standalone.
RUN_POLLER=true
